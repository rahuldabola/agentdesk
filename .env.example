# --- Required ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=            # embeddings for the RAG pipeline

# --- Optional: web search ---
# With a key, web_search uses Tavily. Without one it falls back to scraping
# DuckDuckGo HTML, which is rate-limited and unreliable.
TAVILY_API_KEY=

# --- Optional: model + storage ---
ANTHROPIC_MODEL=claude-sonnet-5
AGENTDESK_CHROMA_DIR=./chroma_db
AGENTDESK_COLLECTION=agentdesk_docs

# --- Optional: retrieval tuning ---
AGENTDESK_CHUNK_SIZE=800
AGENTDESK_CHUNK_OVERLAP=150
AGENTDESK_RETRIEVAL_K=4
# Cosine-distance ceiling for a chunk to count as relevant (0 = identical, 1 = orthogonal).
AGENTDESK_MAX_DISTANCE=0.65

# --- Optional: control loop + resilience ---
AGENTDESK_MAX_REVISIONS=2          # Critic -> Writer rewrites before shipping unverified
AGENTDESK_MAX_RESEARCH_ROUNDS=1    # Critic -> Researcher rounds for evidence gaps
AGENTDESK_LLM_MAX_ATTEMPTS=4       # retries on 429/5xx/connection errors
AGENTDESK_MAX_CONCURRENT_TOOL_CALLS=4
