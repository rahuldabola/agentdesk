# Which LLM provider the agents call: "anthropic" (default) or "gemini"
AI_PROVIDER=anthropic

# Required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Required when AI_PROVIDER=gemini
GEMINI_API_KEY=

# Required for RAG (embeddings)
OPENAI_API_KEY=

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-flash-latest
AGENTDESK_CHROMA_DIR=./chroma_db

# Optional — enables Tavily web search instead of the DuckDuckGo HTML fallback
TAVILY_API_KEY=
